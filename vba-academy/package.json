{
  "name": "vba-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:engine": "esbuild tests/engine.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-engine.mjs --log-level=error && node node_modules/.tmp-engine.mjs",
    "test:lessons": "esbuild tests/lessons.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp-lessons.mjs --log-level=error && node node_modules/.tmp-lessons.mjs",
    "test": "npm run test:engine && npm run test:lessons"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
