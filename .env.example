# ─────────────────────────────────────────────────────────────
#  Spice · Environment
#  คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# [1] ความลับของเซิร์ฟเวอร์ — สร้างด้วย:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SPICE_SECRET_KEY=change-me-please-use-a-long-random-string

# [2] Google OAuth — สร้างที่ https://console.cloud.google.com/apis/credentials
#     ชนิด: "OAuth client ID" → "Web application"
#     Authorized redirect URI:  http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [3] URL ที่เว็บนี้เข้าถึงได้จากภายนอก (ต้องตรงกับที่ตั้งใน Google Console)
SPICE_BASE_URL=http://localhost:8000

# [4] จำกัดผู้เข้าใช้ (ว่าง = เปิดให้ทุกคน). ใส่อีเมลคั่นด้วย comma
#     ตัวอย่าง: SPICE_ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com
SPICE_ALLOWED_EMAILS=
# หรือจำกัดทั้งโดเมน: SPICE_ALLOWED_DOMAINS=mycompany.com
SPICE_ALLOWED_DOMAINS=

# [5] ที่เก็บฐานข้อมูล
SPICE_DB_PATH=./data/spice.db

# [6] โหมดพัฒนา — เปิดปุ่ม "เข้าใช้แบบเดโม" โดยไม่ต้องมี Google (ห้ามเปิดบน production)
SPICE_DEV_LOGIN=0

# [7] คีย์ของผู้ให้บริการ AI (ไม่บังคับ — ใส่เมื่ออยากให้ Agent เรียกโมเดลคลาวด์ได้)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
